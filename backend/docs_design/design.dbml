// audit.export — no storage: the file is read from audit_logs with the list's filters.
//
// notifications.inbox — one row per recipient; created by the event that causes it
// (failed sync, connection needing reauthorization, approval request created/decided)
// and only for recipients allowed to read its subject.
// Table notifications {
//   id uuid [pk]
//   tenant_id uuid [note: 'Null for product notices addressed across workspaces']
//   recipient_user_id uuid [note: 'Null for a product notice shown to every member (with read state in notification_reads)']
//   kind varchar(32) [not null, note: 'product_notice | source_failed | connection_reconnect | access_request | access_request_pending | access_request_approved | access_request_denied']
//   subject_type varchar(32) [note: 'ingestion_source | integration_connection | approval_request | item']
//   subject_id uuid
//   title varchar(255) [not null]
//   body text [not null]
//   href varchar(512) [not null, note: 'App route, never an absolute URL']
//   read_at timestamptz [note: 'Per-recipient rows only']
//   created_at timestamptz [not null]
//   indexes {
//     (recipient_user_id, tenant_id, read_at, created_at)
//     (subject_type, subject_id)
//   }
// }
// Table notification_reads {
//   notification_id uuid [not null]
//   user_id uuid [not null]
//   read_at timestamptz [not null]
//   indexes { (notification_id, user_id) [pk] }
//   Note: 'Read state of broadcast product notices (recipient_user_id null).'
// }
// Ref: notifications.tenant_id > tenants.id
// Ref: notifications.recipient_user_id > users.id
// Ref: notification_reads.notification_id > notifications.id
// Ref: notification_reads.user_id > users.id
//
// platform.workspace_admin — no new table. POST creates tenants (code unique,
// ^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$) plus the owner's tenant_membership and
// workspace-admin role_assignment (or a pending invitation when the email has no
// user yet). PATCH sets tenants.status active | suspended; access_sessions in a
// suspended tenant stop authorizing. New permission code platform.tenant.manage.
//
// platform.user_admin — no new table. is_platform_admin is a role_assignment of the
// platform admin role (roles.tenant_id null); account suspension is users.status
// (false = suspended), which also revokes active access_sessions. Self-changes are
// rejected. New permission code platform.user.manage.
//
// platform.connectors — deployment-wide connector settings; secrets encrypted and write-only.
// Table platform_connector_settings {
//   connector_key varchar(64) [pk, note: 'Registry key, e.g. google_drive']
//   available boolean [not null, default: true, note: 'False stops new connections and syncs; documents stay searchable']
//   oauth_client_id varchar(512)
//   oauth_client_secret_encrypted bytea [note: 'Encrypted with the integration encryption key; never returned (responses expose has_secret only)']
//   updated_by_user_id uuid
//   updated_at timestamptz [not null]
//   Note: 'No row = registry defaults and deployment environment configuration. New permission code platform.connector.manage.'
// }
// Ref: platform_connector_settings.updated_by_user_id > users.id
//
// platform.capabilities — no storage: read from deployment configuration and health probes.
// platform.usage — no new table: aggregated from messages, access_sessions and ingestion_run_items.
//
