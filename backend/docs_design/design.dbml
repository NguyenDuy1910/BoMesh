//
// document.restore — restore reverses the Document tombstone on items.
// items: restore sets status back to the value it had before deletion and clears
// deleted_at, within a 30-day retention window after which the tombstone is purged.
// Proposed column: items.status_before_delete varchar(16) [note: 'Raw status at deletion; null while live'].
// Citations tombstoned with the Document are reactivated (citations.deleted_at cleared);
// if the index cannot be restored, index_status is set to pending for a new run.
//
// collection.general_access — "everyone in the workspace can view" a Collection.
// role_assignments gains the workspace as a principal: proposed column
// role_assignments.all_members boolean [not null, default: false, note: 'With item_id set and user_id/group_id null: every active member of tenant_id holds role_id (collection_viewer only) on that Collection']
// (the exactly-one-principal check becomes user_id | group_id | all_members). Collection reads expose it as general_access.
// collection.discovery — a read projection; no storage.
//
// workspace.assistant_settings — one row per workspace.
// Table workspace_assistant_settings {
//   tenant_id uuid [pk]
//   instructions text [not null, note: '<= 2000 characters']
//   answer_length varchar(16) [not null, default: 'balanced', note: 'concise | balanced | detailed']
//   capabilities jsonb [not null, default: `{"web_search": false, "file_work": true, "charts": true}`]
//   welcome_message varchar(60) [not null]
//   starter_prompts jsonb [not null, default: `[]`, note: '<= 3 {title <= 40, prompt <= 160}']
//   updated_by_user_id uuid
//   updated_at timestamptz [not null]
//   Note: 'Knowledge search is always on and is not stored. No row = product defaults.'
// }
// Ref: workspace_assistant_settings.tenant_id - tenants.id
// Ref: workspace_assistant_settings.updated_by_user_id > users.id
//
// workspace.branding — tenants.settings.branding = {accent: indigo|teal|ocean|plum|graphite, updated_at}.
// workspace.archive — tenants.status gains 'archived' (with settings.archive = {archived_at, archived_by_user_id}).
//
// account.notification_prefs — users.preferences.notifications =
//   {email: {source_sync_failures, access_requests, cited_document_changes, weekly_summary}, updated_at}
//   (booleans, default true; account-wide, not per workspace).
//
// analytics.knowledge_gaps — gaps are computed from user messages and answer
// feedback (no stored list); only an administrator's dismissal is persisted.
// Table knowledge_gap_dismissals {
