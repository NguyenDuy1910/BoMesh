Ref: contributions.target_item_id > items.id
Ref: contributions.replaces_item_id > items.id
Ref: contributions.contributor_user_id > users.id
Ref: contributions.ingestion_source_id > ingestion_sources.id
Ref: contributions.decided_by_user_id > users.id
Ref: topics.tenant_id > tenants.id
Ref: topics.parent_topic_id > topics.id
Ref: topics.created_by_user_id > users.id
Ref: item_topics.item_id > items.id
Ref: item_topics.topic_id > topics.id
Ref: item_topics.created_by_user_id > users.id
Ref: contribution_topics.contribution_id > contributions.id
Ref: contribution_topics.topic_id > topics.id
Ref: reading_lists.tenant_id > tenants.id
Ref: reading_lists.owner_user_id > users.id
Ref: reading_lists.space_id > spaces.id
Ref: reading_list_entries.reading_list_id > reading_lists.id
Ref: reading_list_entries.item_id > items.id
Ref: reading_list_entries.added_by_user_id > users.id
Ref: item_links.tenant_id > tenants.id
Ref: item_links.collection_item_id > items.id
Ref: item_links.target_item_id > items.id
Ref: item_links.created_by_user_id > users.id
Ref: saved_items.tenant_id > tenants.id
Ref: saved_items.user_id > users.id
Ref: saved_items.item_id > items.id
Ref: recent_items.tenant_id > tenants.id
Ref: recent_items.user_id > users.id
Ref: recent_items.item_id > items.id
Ref: saved_searches.tenant_id > tenants.id
Ref: saved_searches.user_id > users.id
Ref: citations.item_id > items.id
Ref: item_uploads.item_id - items.id
Ref: item_uploads.tenant_id > tenants.id
Ref: item_uploads.owner_user_id > users.id

Ref: integration_connections.tenant_id > tenants.id
Ref: integration_connections.owner_user_id > users.id
Ref: integration_connections.created_by_user_id > users.id
Ref: integration_credentials.integration_connection_id - integration_connections.id
Ref: ingestion_sources.tenant_id > tenants.id
Ref: ingestion_sources.integration_connection_id > integration_connections.id
Ref: ingestion_sources.target_item_id > items.id
Ref: ingestion_sources.created_by_user_id > users.id
Ref: ingestion_syncs.ingestion_source_id > ingestion_sources.id
Ref: ingestion_syncs.created_by_user_id > users.id
Ref: external_resources.item_id > items.id
Ref: external_resources.ingestion_source_id > ingestion_sources.id
Ref: ingestion_runs.tenant_id > tenants.id
Ref: ingestion_runs.retry_of_run_id > ingestion_runs.id
Ref: ingestion_runs.created_by_user_id > users.id
Ref: ingestion_run_items.run_id > ingestion_runs.id
Ref: ingestion_run_items.item_id > items.id
Ref: ingestion_policies.updated_by_user_id > users.id
Ref: platform_connector_settings.updated_by_user_id > users.id

Ref: conversations.tenant_id > tenants.id
Ref: conversations.owner_user_id > users.id
Ref: conversations.created_by_session_id > access_sessions.id
Ref: sandbox_sessions.tenant_id > tenants.id
Ref: sandbox_sessions.conversation_id > conversations.id
Ref: sandbox_sessions.user_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: message_items.message_id > messages.id
Ref: message_items.item_id > items.id
Ref: artifacts.item_id - items.id
Ref: artifacts.owner_user_id > users.id
Ref: artifacts.conversation_id > conversations.id
Ref: artifacts.space_id > spaces.id
Ref: artifact_source_items.artifact_item_id > artifacts.item_id
Ref: artifact_source_items.item_id > items.id
Ref: evidence_review_cells.artifact_item_id > artifacts.item_id
Ref: conversation_shares.tenant_id > tenants.id
Ref: conversation_shares.conversation_id > conversations.id
Ref: conversation_shares.owner_user_id > users.id
Ref: conversation_share_recipients.share_id > conversation_shares.id
Ref: conversation_share_recipients.user_id > users.id
Ref: memories.tenant_id > tenants.id
Ref: memories.user_id > users.id
Ref: memories.conversation_id > conversations.id
Ref: memories.source_message_id > messages.id
Ref: workspace_assistant_settings.tenant_id - tenants.id
Ref: workspace_assistant_settings.updated_by_user_id > users.id
Ref: knowledge_gap_decisions.tenant_id > tenants.id
Ref: knowledge_gap_decisions.resolved_by_item_id > items.id
Ref: knowledge_gap_decisions.decided_by_user_id > users.id

Ref: spaces.tenant_id > tenants.id
Ref: spaces.created_by_user_id > users.id
Ref: space_materials.space_id > spaces.id
Ref: space_materials.item_id > items.id
Ref: space_materials.added_by_user_id > users.id
Ref: space_announcements.space_id > spaces.id
Ref: space_announcements.author_user_id > users.id
Ref: space_events.space_id > spaces.id
Ref: space_events.created_by_user_id > users.id
Ref: request_types.space_id > spaces.id
Ref: request_types.created_by_user_id > users.id
Ref: requests.tenant_id > tenants.id
Ref: requests.request_type_id > request_types.id
Ref: requests.space_id > spaces.id
Ref: requests.collection_item_id > items.id
Ref: requests.requested_role_id > roles.id
Ref: requests.granted_role_id > roles.id
