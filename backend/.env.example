# BoMesh environment template.
#
# `make config` (run by `make init`) copies this file to the repository-root
# `.env`, points PostgreSQL, Qdrant, RustFS and Gotenberg at the local Compose
# services, and generates the local secrets that are still empty. Fill in the
# model settings below; everything else has a working local default.
# Boolean settings are JSON booleans (true/false).

## Models
# Every model call uses only the models configured here.
# Embeddings (unless BOMESH_EMBEDDING_PROVIDER says otherwise), chunk
# contextualization, document vision and reranking run on OpenRouter.
# The conversation agent runs on OpenRouter when OPENROUTER_API_KEY
# and OPENROUTER_MODEL are both set, otherwise on OpenAI with OPENAI_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenCode inference API (https://opencode.ai/inference). OPENCODE_MODEL is the
# agent's model with BOMESH_AGENT_MODEL_PROVIDER=opencode; it must be one OpenCode
# serves on the Responses API (GPT models), e.g. openai/gpt-5.6-luna.
OPENCODE_API_KEY=
OPENCODE_MODEL=
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Named in OpenRouter form (openai/text-embedding-3-small); it is the model identity
# index points record, whichever provider serves it.
EMBEDDING_MODEL=
BOMESH_CONTEXTUALIZATION_MODEL=
# Vision model that transcribes scanned PDF pages; without it a scanned PDF
# fails with "the file has no text to index".
BOMESH_DOCLING_MODEL=
# Optional: openai | openrouter | opencode, overriding the automatic choice above.
BOMESH_AGENT_MODEL_PROVIDER=
# Optional: openrouter (default) | openai | opencode. OpenAI serves only openai/
# models; switching provider for the same model keeps every indexed vector.
BOMESH_EMBEDDING_PROVIDER=
# Optional: none | minimal | low | medium | high.
BOMESH_AGENT_REASONING_EFFORT=
BOMESH_CONTEXTUALIZATION_ENABLED=true
BOMESH_CONTEXTUALIZATION_REASONING_EFFORT=
BOMESH_RERANKING_ENABLED=false
BOMESH_RERANKER_MODEL=
# OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

## API server
BOMESH_HOST=127.0.0.1
BOMESH_PORT=8000
BOMESH_LOG_LEVEL=INFO
# Comma-separated web origins allowed by CORS (e.g. https://app.example.com);
# empty allows any origin, for local development only.
BOMESH_WEB_ORIGINS=

## PostgreSQL (set by `make config` for local Compose)
DATABASE_URL=postgresql+asyncpg://bomesh:bomesh@127.0.0.1:5432/bomesh
# BOMESH_DB_POOL_SIZE=20
# BOMESH_DB_MAX_OVERFLOW=20

## Authentication
# Signs access tokens and keys request idempotency hashes; at least 32 random
# bytes. `make config` generates one when empty: openssl rand -base64 48
BOMESH_AUTH_JWT_SECRET=
BOMESH_AUTH_JWT_ISSUER=bomesh
BOMESH_AUTH_JWT_AUDIENCE=bomesh-api
BOMESH_AUTH_JWT_EXPIRES_IN_SECONDS=900
# Google sign-in: must equal NEXT_PUBLIC_GOOGLE_CLIENT_ID below.
BOMESH_GOOGLE_CLIENT_ID=
# BOMESH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Comma-separated verified Google account emails granted the platform admin role.
BOMESH_PLATFORM_ADMIN_EMAILS=

## Web app (read by apps/web from this root file)
NEXT_PUBLIC_BOMESH_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 1 enables development-only client adapters.
NEXT_PUBLIC_BOMESH_DEV_ADAPTERS=

## Qdrant (set by `make config` for local Compose)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bomesh
QDRANT_PREFER_GRPC=false
BOMESH_DOCUMENT_EMBEDDING_BATCH_SIZE=32

## Object storage: rustfs (local Compose) | aws_s3 | cloudflare_r2
BOMESH_OBJECT_STORAGE_PROVIDER=rustfs
BOMESH_OBJECT_STORAGE_BUCKET=bomesh

### RustFS and AWS S3
BOMESH_S3_ENDPOINT_URL=http://127.0.0.1:9000
# Host browsers use for signed URLs; defaults to BOMESH_S3_ENDPOINT_URL.
BOMESH_S3_PUBLIC_ENDPOINT_URL=
BOMESH_S3_REGION=us-east-1
# path for RustFS; auto for AWS S3.
BOMESH_S3_ADDRESSING_STYLE=path
# BOMESH_S3_TIMEOUT_SECONDS=20
# BOMESH_S3_MAX_POOL_CONNECTIONS=20
# RustFS credentials, shared by the API and the RustFS container
# (`make config` generates the secret). AWS S3 uses the standard AWS
# credential chain instead.
RUSTFS_ACCESS_KEY=bomesh
RUSTFS_SECRET_KEY=

### Cloudflare R2 (BOMESH_OBJECT_STORAGE_PROVIDER=cloudflare_r2)
# The endpoint is derived from the account ID unless BOMESH_R2_ENDPOINT_URL is set.
BOMESH_R2_BUCKET=
BOMESH_R2_ACCOUNT_ID=
BOMESH_R2_ENDPOINT_URL=
BOMESH_R2_ACCESS_KEY_ID=
BOMESH_R2_SECRET_ACCESS_KEY=
# BOMESH_R2_TIMEOUT_SECONDS=20
# BOMESH_R2_MAX_POOL_CONNECTIONS=20

## Uploads and previews
# BOMESH_DOCUMENT_MAX_UPLOAD_BYTES=104857600
# BOMESH_DOCUMENT_MAX_PROCESSING_BYTES=104857600
# BOMESH_DOCUMENT_UPLOAD_URL_SECONDS=600
# BOMESH_DOCUMENT_CITATION_URL_SECONDS=300
BOMESH_GOTENBERG_URL=http://127.0.0.1:3010
# BOMESH_PREVIEW_CONVERSIONS=2
# BOMESH_PREVIEW_URL_SECONDS=300
# BOMESH_PREVIEW_COVER_URL_SECONDS=3600

## Retrieval
# BOMESH_RETRIEVAL_CANDIDATE_COUNT=20
# BOMESH_FINAL_RETRIEVAL_TOP_K=6
# BOMESH_RETRIEVAL_CONTEXT_CHARACTERS=8000
# BOMESH_RERANK_TIMEOUT_SECONDS=8
# BOMESH_QUERY_EMBEDDING_CACHE_SIZE=512
# One deadline for a text search's query embedding and vector query (SearchItems → 503 past it)
# BOMESH_SEARCH_DEADLINE_SECONDS=8

## Conversation agent
# BOMESH_MAX_MODEL_TURNS=8
# BOMESH_MAX_TOOL_ROUNDS=4
# BOMESH_MAX_TOOL_CALLS=6
# BOMESH_MAX_HISTORY_MESSAGES=24
# BOMESH_MAX_HISTORY_CHARACTERS=24000
# BOMESH_TOOL_TIMEOUT_SECONDS=30
# BOMESH_MAX_RESOURCE_READ_CHARACTERS=12000
# BOMESH_AGENT_MAX_TOOL_CONTEXT_CHARACTERS=60000

## Artifacts
# BOMESH_ARTIFACT_MAX_CONTENT_BYTES=2097152
# BOMESH_ARTIFACT_CONTEXT_CHARACTERS=20000
# BOMESH_ARTIFACT_RESULT_CHARACTERS=8000
# BOMESH_ARTIFACT_DOWNLOAD_URL_SECONDS=300

## File-work sandbox (Docker; build the image once:
## docker build -t bomesh-sandbox:latest deployment/sandbox)
BOMESH_SANDBOX_ENABLED=true
BOMESH_SANDBOX_IMAGE=bomesh-sandbox:latest
# BOMESH_SANDBOX_WARM_POOL_SIZE=2
# BOMESH_SANDBOX_IDLE_TTL_SECONDS=1800
# BOMESH_SANDBOX_MEMORY=1g
# BOMESH_SANDBOX_CPUS=1
# BOMESH_SANDBOX_PIDS_LIMIT=256
# BOMESH_SANDBOX_COMMAND_TIMEOUT_SECONDS=60
# BOMESH_SANDBOX_MAX_OUTPUT_CHARACTERS=8000

## Ingestion worker (PostgreSQL is the queue)
# BOMESH_INGESTION_MAX_CONCURRENT_RUNS=2
# BOMESH_INGESTION_MAX_CONCURRENT_DOCUMENTS=4
# Direct PostgreSQL connection that holds the run advisory locks; needed when
# DATABASE_URL goes through a transaction pooler.
# BOMESH_INGESTION_LOCK_DATABASE_URL=
# BOMESH_INGESTION_BATCH_MAX_ITEMS=8
# BOMESH_INGESTION_BATCH_MAX_BYTES=67108864
# BOMESH_INGESTION_RUN_PARALLELISM=4
# Comma-separated MIME types; empty uses the built-in knowledge formats.
# BOMESH_INGESTION_POLICY_ALLOWED_MIME_TYPES=
# BOMESH_INGESTION_POLICY_MAX_FILE_SIZE_BYTES=104857600
# BOMESH_INGESTION_POLICY_OCR_SCANNED_PDFS=true
# BOMESH_INGESTION_POLICY_PARSE_SPREADSHEETS=true
# BOMESH_INGESTION_POLICY_REJECTED_RETENTION_SECONDS=2592000

## Connectors
# URL-safe base64 of exactly 32 random bytes; encrypts stored connector
# credentials. `make config` generates one when empty.
BOMESH_INTEGRATION_ENCRYPTION_KEY=
# One redirect URI serves every provider; register it in each provider console.
BOMESH_INTEGRATION_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connections/authorizations/callback
# The web origin allowed to receive the authorization popup's result.
BOMESH_INTEGRATION_OAUTH_CLIENT_ORIGIN=http://127.0.0.1:3000
# Protects the OAuth state; distinct from every other secret: openssl rand -base64 48
BOMESH_INTEGRATION_OAUTH_STATE_SECRET=
# BOMESH_INTEGRATION_OAUTH_TIMEOUT_SECONDS=20
# Google Drive connector (a separate client from BOMESH_GOOGLE_CLIENT_ID).
BOMESH_GOOGLE_OAUTH_CLIENT_ID=
BOMESH_GOOGLE_OAUTH_CLIENT_SECRET=
# Confluence connector (Atlassian 3LO app).
BOMESH_ATLASSIAN_OAUTH_CLIENT_ID=
BOMESH_ATLASSIAN_OAUTH_CLIENT_SECRET=

## Observability (optional Langfuse tracing)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

## Tests
# PostgreSQL server the API test suite creates throwaway databases on.
TEST_DATABASE_URL=postgresql+asyncpg://bomesh:bomesh@127.0.0.1:5432/bomesh
